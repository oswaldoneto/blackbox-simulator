{
  "name": "blackbox-simulator",
  "version": "0.4.0",
  "description": "Coleta, registra e visualiza parâmetros de voo do Microsoft Flight Simulator 2024.",
  "main": "dist/main/main/index.js",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev:renderer": "vite",
    "dev:main": "concurrently \"tsc -p tsconfig.main.json --watch\" \"esbuild src/main/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/main/main/preload.js --watch\"",
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "build:renderer": "vite build",
    "clean:main": "node -e \"require('fs').rmSync('dist/main',{recursive:true,force:true})\"",
    "build:main": "npm run clean:main && tsc -p tsconfig.main.json && npm run build:preload && npm run copy:migrations",
    "build:preload": "tsc -p tsconfig.preload.json && esbuild src/main/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/main/main/preload.js",
    "copy:migrations": "node -e \"require('fs').cpSync('src/main/db/migrations','dist/main/main/db/migrations',{recursive:true})\"",
    "build": "npm run build:renderer && npm run build:main",
    "start": "electron .",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "postinstall": "electron-builder install-app-deps",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "better-sqlite3": "^9.4.3",
    "node-simconnect": "^4.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/better-sqlite3": "^7.6.8",
    "@types/react": "^18.2.67",
    "@types/react-dom": "^18.2.22",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.4.0",
    "concurrently": "^8.2.2",
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.21.5",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.1",
    "prettier": "^3.2.5",
    "typescript": "^5.4.3",
    "vite": "^5.2.0",
    "vitest": "^1.4.0"
  },
  "build": {
    "appId": "com.dio.blackbox-simulator",
    "productName": "Blackbox Simulator",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "BlackboxSimulator-Setup-${version}.${ext}"
    }
  }
}
